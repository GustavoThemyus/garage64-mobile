# Copie para .env e preencha. Só variáveis EXPO_PUBLIC_* chegam ao app, e tudo que
# começa assim fica visível no bundle: nunca coloque aqui uma chave secreta.
# Sem nenhuma delas o app roda 100% local (catálogo mock, builds no aparelho,
# Assistant offline). Contratos e etapas em docs/deploy.md.

# URL base da API Next.js (sem barra no fim). Liga o Assistant.
EXPO_PUBLIC_API_URL=

# Supabase (fase 2). A anon key é pública por desenho: quem protege os dados é o RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
